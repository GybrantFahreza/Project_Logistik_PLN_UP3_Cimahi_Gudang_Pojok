<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvNoUrut"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="1."
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etNamaBarang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:textSize="12sp"
            android:padding="8dp"
            android:layout_marginEnd="4dp"
            android:inputType="textCapCharacters|textMultiLine"
            android:maxLines="3"/>

        <TextView
            android:id="@+id/tvGarduPekerjaan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Untuk Pekerjaan: RCP"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#4B5563"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:background="#E5E7EB"/>

        <TextView
            android:id="@+id/tvBadgeTanpaSlip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BELUM JADI SLIP"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:textSize="10sp"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="#FFEBEE"
            android:visibility="gone"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etQty"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:background="@android:drawable/edit_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:inputType="number"
        android:layout_marginEnd="4dp"/>

    <EditText
        android:id="@+id/etSatuan"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:background="@android:drawable/edit_text"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="8dp"
        android:inputType="textCapCharacters"
        android:layout_marginEnd="4dp"/>

    <Button
        android:id="@+id/btnHapusItem"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="✖"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        android:padding="0dp"
        android:textSize="14sp"/>

</LinearLayout>