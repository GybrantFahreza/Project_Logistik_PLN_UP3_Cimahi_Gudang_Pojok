<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Title with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_vault"
            app:tint="@color/primary_blue"
            android:layout_marginEnd="12dp"
            android:contentDescription="Vault Icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur Jumlah Dibawa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"/>
    </LinearLayout>

    <!-- Card Info Material -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F3F4F6"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvNamaMaterialDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Barang"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1F2937"/>

            <TextView
                android:id="@+id/tvStokMaksDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Surat Jalan: 0 BH"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Berapa jumlah barang yang diangkut ke Truk hari ini?\nSisanya akan otomatis disisihkan ke Gudang Sisa."
        android:textSize="13sp"
        android:textColor="#4B5563"
        android:layout_marginBottom="12dp"/>

    <!-- Input Outlined Box -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilQtyDibawa"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="QTY Dibawa Hari Ini"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etQtyDibawa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="16sp"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
