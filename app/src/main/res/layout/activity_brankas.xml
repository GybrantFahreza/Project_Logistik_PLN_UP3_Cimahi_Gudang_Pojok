<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Header Toolbar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/toolbarCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Normal Header -->
            <RelativeLayout
                android:id="@+id/layoutNormalHeader"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="16dp"
                android:visibility="visible">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Daftar Pekerjaan / PT Hari Ini"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"/>
            </RelativeLayout>

        <!-- Selection Mode Header (Aktif saat item diklik lama / terpilih) -->
        <RelativeLayout
            android:id="@+id/layoutSelectionHeader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCancelSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#374151"
                android:contentDescription="Batal Seleksi"/>

            <TextView
                android:id="@+id/tvSelectedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnCancelSelection"
                android:layout_marginStart="16dp"
                android:text="1 Item Terpilih"
                android:textColor="#1F2937"
                android:textStyle="bold"
                android:textSize="18sp"/>

            <ImageButton
                android:id="@+id/btnOverflowMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                app:tint="#374151"
                android:contentDescription="Opsi Menu"/>
        </RelativeLayout>

        <!-- Banner Reminder Belum Diambil -->
        <TextView
            android:id="@+id/tvReminderGudang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFEBEE"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="10dp"
            android:gravity="center"
            android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Button Preview List Surat Jalan Masuk Hari Ini -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPreviewSj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbarCard"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#E3F2FD"
        app:cardElevation="2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_document_add"
                app:tint="@color/primary_blue"
                android:contentDescription="Icon Surat Jalan"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvPreviewSjTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total SJ Di-Scan Hari Ini"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_blue"/>

                <TextView
                    android:id="@+id/tvPreviewSjSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Klik untuk melihat riwayat surat yang diproses hari ini"
                    android:textSize="11sp"
                    android:textColor="#4B5563"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPreviewSjCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 SJ >"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBrankas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/cardPreviewSj"
        android:layout_above="@+id/bottomNavContainer"
        android:paddingTop="6dp"
        android:clipToPadding="false"/>


    <RelativeLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:elevation="8dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled"
            app:itemIconTint="@color/bottom_nav_color"
            app:itemTextColor="@color/bottom_nav_color"
            app:itemActiveIndicatorStyle="@style/Widget.App.BottomNavigationView.ActiveIndicator"
            app:itemRippleColor="@color/bottom_nav_ripple_color"/>

        <FrameLayout
            android:id="@+id/btnCenterScan"
            android:layout_width="54dp"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_center_add"
            android:elevation="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#000000"
                android:textSize="26sp"
                android:layout_gravity="center"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </RelativeLayout>

</RelativeLayout>
