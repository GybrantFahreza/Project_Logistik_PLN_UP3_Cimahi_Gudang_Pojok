<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="2dp"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNoSjPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No SJ: 1013.TP/LOG.00.02/F02050000/2026"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:id="@+id/tvVendorPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diberikan Kepada: LEMBANG"
                android:textSize="12sp"
                android:textColor="#374151"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvPekerjaanPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Untuk Pekerjaan: PERSEDIAAN GUDANG ULP LEMBANG"
                android:textSize="11sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lihat >"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="#E3F2FD"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
